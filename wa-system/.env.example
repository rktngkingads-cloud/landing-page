# Use the Graph API version displayed in Meta Developer settings.
WA_GRAPH_API_VERSION=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# Required: comma-separated opt-in/test numbers, digits only with country code.
# Empty means no automatic replies are sent.
WA_ALLOWED_RECIPIENTS=60123456789

# Keep the automated nature clear in the default reply.
WA_AUTO_REPLY_TEXT=Balasan otomatis: Terima kasih, pesan Anda sudah diterima.

# Optional keyword rules as a JSON object.
# WA_AUTO_REPLY_RULES={"harga":"Balasan otomatis: Informasi harga sedang kami siapkan.","halo":"Balasan otomatis: Halo, terima kasih sudah menghubungi kami."}
WA_AUTO_REPLY_RULES=

# Per-recipient debounce/rate-limit range.
WA_COOLDOWN_MIN_SECONDS=16
WA_COOLDOWN_MAX_SECONDS=20

# Protects the read-only /messages endpoint.
WA_ADMIN_API_KEY=
WA_DB_PATH=data/wa-system.db
LOG_LEVEL=INFO
