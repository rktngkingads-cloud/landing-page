# Use the current Graph API version shown in your Meta developer dashboard, e.g. vXX.X
WA_GRAPH_API_VERSION=

# WhatsApp Business Platform / Cloud API credentials
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=

# Choose a long random value and enter the same value in Meta webhook settings
WA_VERIFY_TOKEN=

# Optional comma-separated digits-only numbers. Strongly recommended in testing.
# Example: 60123456789,85512345678
WA_ALLOWED_RECIPIENTS=

# Leave empty to receive webhooks without sending an automatic reply
WA_AUTO_REPLY_TEXT=Terima kasih. Pesan Anda sudah diterima dan akan segera diproses.
LOG_LEVEL=INFO
